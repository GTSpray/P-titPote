{
  "$schema": "../schema/scenario.schema.json",
  "id": "alias-say",
  "title": "Alias — poster un message stocké",
  "doc": "docs/usage/alias/alias.md",
  "chrome": {
    "guild": {
      "name": "Serveur de démo"
    },
    "channel": {
      "name": "général",
      "type": "text"
    },
    "membersOnline": 8,
    "viewer": {
      "name": "Modo",
      "status": "Online"
    }
  },
  "defaults": {
    "botPendingText": "Envoi de la commande..."
  },
  "actions": [
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "focusInput"
    },
    {
      "type": "wait",
      "ms": 1200
    },
    {
      "type": "type",
      "text": "/alias say",
      "revealSuggestions": {
        "mode": "commandMatch",
        "activeIndex": 0,
        "suggestions": [
          {
            "name": "/alias say",
            "description": "demande a p'titpote d'envoyer le message"
          }
        ]
      }
    },
    {
      "type": "wait",
      "ms": 800
    },
    {
      "type": "pressEnter"
    },
    {
      "type": "openModal",
      "modal": {
        "type": 9,
        "author": {
          "name": "P'tit Pote",
          "bot": true,
          "avatarUrl": "https://raw.githubusercontent.com/GTSpray/P-titPote/main/assets/ptitpote.png"
        },
        "data": {
          "title": "Poster un alias",
          "components": [
            {
              "type": 18,
              "label": "alias du message",
              "component": {
                "type": 3,
                "custom_id": "alias",
                "placeholder": "Choisis un alias...",
                "options": [
                  {
                    "label": "rules",
                    "value": "rules",
                    "emoji": {
                      "name": "▪️"
                    }
                  },
                  {
                    "label": "welcome",
                    "value": "welcome",
                    "emoji": {
                      "name": "▪️"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "type": "selectModalOption",
      "field": "alias",
      "option": "welcome",
      "options": [
        {
          "label": "rules"
        },
        {
          "label": "welcome"
        }
      ]
    },
    {
      "type": "wait",
      "ms": 700
    },
    {
      "type": "submitModal"
    },
    {
      "type": "applyState",
      "layers": {
        "messages": [
          {
            "author": {
              "name": "P'tit Pote",
              "bot": true,
              "avatarUrl": "https://raw.githubusercontent.com/GTSpray/P-titPote/main/assets/ptitpote.png"
            },
            "timestamp": "14:10",
            "slashInvocation": {
              "user": {
                "name": "Modo",
                "color": "#5865f2"
              },
              "command": "alias say"
            },
            "interaction": {
              "type": 4,
              "data": {
                "flags": 32768,
                "components": [
                  {
                    "type": 10,
                    "content": "Bienvenue sur le serveur !"
                  }
                ]
              }
            }
          }
        ]
      },
      "holdMs": 2500
    }
  ],
  "output": {
    "directory": "docs/usage/alias",
    "prefix": "alias-say",
    "video": true
  }
}
