{
  "$schema": "../schema/scenario.schema.json",
  "id": "remind-on",
  "title": "Remind — activer un rappel",
  "doc": "docs/usage/remind/remind.md",
  "chrome": {
    "guild": {
      "name": "Serveur de démo"
    },
    "channel": {
      "name": "idée-barbecue",
      "type": "text"
    },
    "membersOnline": 8,
    "viewer": {
      "name": "Alex",
      "status": "Online"
    }
  },
  "defaults": {
    "botPendingText": "Envoi de la commande..."
  },
  "actions": [
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "focusInput"
    },
    {
      "type": "wait",
      "ms": 1200
    },
    {
      "type": "type",
      "text": "/remind on",
      "revealSuggestions": {
        "mode": "commandMatch",
        "activeIndex": 0,
        "suggestions": [
          {
            "name": "/remind on",
            "description": "Active un rappel de remontée sur ce fil"
          }
        ]
      }
    },
    {
      "type": "wait",
      "ms": 800
    },
    {
      "type": "pressEnter"
    },
    {
      "type": "wait",
      "ms": 600
    },
    {
      "type": "type",
      "text": "3"
    },
    {
      "type": "wait",
      "ms": 600
    },
    {
      "type": "pressEnter"
    },
    {
      "type": "showEphemeral",
      "ephemeral": {
        "author": {
          "name": "P'tit Pote",
          "bot": true,
          "avatarUrl": "https://raw.githubusercontent.com/GTSpray/P-titPote/main/assets/ptitpote.png"
        },
        "type": 4,
        "data": {
          "flags": 64,
          "content": "Ok! Je remonterai ce fil s'il reste silencieux 3 jour(s) ;)"
        }
      }
    },
    {
      "type": "wait",
      "ms": 2500
    }
  ],
  "output": {
    "directory": "docs/usage/remind",
    "prefix": "remind-on",
    "video": true
  }
}
